# HortusFox REST API base URL (no trailing slash, no /api suffix).
# This server appends /api/<path> on top of it.
HORTUSFOX_API_BASE_URL=https://pablos-macbook-air.tailff483a.ts.net

# HortusFox API token. Generate one in the admin dashboard, then store it
# here. Treat as a secret — mcp/.env is gitignored.
HORTUSFOX_API_TOKEN=replace_me_with_a_real_token

# User ID injected into API calls that require a `user` field
# (currently: add_moisture_reading). Defaults to 1 (the first admin).
HORTUSFOX_DEFAULT_USER_ID=1
