# Sidecar HTTP auth. Must match the value visible to PHP via AI_CHAT_SIDECAR_TOKEN.
AI_CHAT_SIDECAR_TOKEN=change-me

# Runtime defaults. app/config/ai_chat.json can send per-request overrides.
AI_CHAT_HOST=127.0.0.1
AI_CHAT_PORT=8787
AI_CHAT_MODEL=opencode-go/deepseek-v4-pro
AI_CHAT_THINKING_LEVEL=off

# Optional: use a dedicated pi config/auth dir. Defaults to ~/.pi/agent.
# PI_CODING_AGENT_DIR=/Users/YOU/.pi/agent

# HortusFox API credentials are loaded from ../mcp/.env first.
# Values here override ../mcp/.env if set.
# HORTUSFOX_API_BASE_URL=https://your-host
# HORTUSFOX_API_TOKEN=your-token
# HORTUSFOX_DEFAULT_USER_ID=1
